# Salin ke .env lalu isi. File .env tidak ikut ke git.

# Domain publik (dipakai untuk link preview WhatsApp/IG). Tanpa garis miring di akhir.
PUBLIC_URL=https://namamu.my.id

# Password halaman /admin. Pakai yang panjang dan acak.
ADMIN_PASSWORD=

# Ditampilkan di pitch bar demo: "dibuat oleh <PITCH_NAME>" + tombol chat ke nomor ini.
PITCH_NAME=
PITCH_WHATSAPP=6285121022185

# Token dari Cloudflare Zero Trust > Networks > Tunnels. Arahkan public hostname ke http://app:3000
TUNNEL_TOKEN=
